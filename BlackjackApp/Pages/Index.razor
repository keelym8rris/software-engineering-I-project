@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Logging
@inject NavigationManager Nav
@inject ILogger<Index> Logger
@implements IAsyncDisposable

<div class="lobby">
    <h1>♠ Blackjack</h1>

    @if (!_connected)
    {
        <p class="status">@(_error.Length == 0 ? "Connecting..." : "The game server is unavailable.")</p>
        @if (_error.Length > 0)
        {
            <p class="error" role="alert">@_error</p>
        }
    }
    else
    {
        <div class="lobby-panel">
            <input @bind="_playerName" @bind:event="oninput" placeholder="Your name" maxlength="20" class="input" />

            <div class="lobby-actions">
                <button class="btn btn-primary" @onclick="CreateGame" disabled="@string.IsNullOrWhiteSpace(_playerName)">
                    Create New Game
                </button>
            </div>

            @if (_openGames.Count > 0)
            {
                <h3>Open Games</h3>
                <ul class="game-list">
                    @foreach (var g in _openGames)
                    {
                        <li>
                            <span>Game @g.GameId — @g.PlayerCount player(s)</span>
                            <button class="btn btn-secondary" @onclick="() => JoinGame(g.GameId)"
                                    disabled="@string.IsNullOrWhiteSpace(_playerName)">
                                Join
                            </button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="muted">No open games. Create one!</p>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="error" role="alert">@_error</p>
            }
        </div>
    }
</div>

@code {
    private HubConnection? _hub;
    private string _playerName = "";
    private string _error = "";
    private bool _connected = false;
    private List<GameSummary> _openGames = new();

    record GameSummary(string GameId, int PlayerCount);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/blackjackhub"))
                .WithAutomaticReconnect()
                .Build();

            _hub.On<string, string>("GameCreated", NavigateToGame);
            _hub.On<string, string>("GameJoined", NavigateToGame);
            _hub.On<string>("Error", ShowServerError);
            _hub.On<List<GameSummary>>("OpenGames", UpdateOpenGames);

            _hub.Reconnecting += exception => InvokeAsync(() =>
            {
                _connected = false;
                _error = "Connection lost. Reconnecting...";
                StateHasChanged();
            });
            _hub.Reconnected += _ => InvokeAsync(async () =>
            {
                _connected = true;
                _error = "";
                await SendHubRequestAsync("GetOpenGames");
                StateHasChanged();
            });
            _hub.Closed += exception => InvokeAsync(() =>
            {
                _connected = false;
                _error = "The connection closed. Refresh the page to try again.";
                StateHasChanged();
            });

            await _hub.StartAsync();
            _connected = true;
            await SendHubRequestAsync("GetOpenGames");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not connect to the blackjack server");
            _connected = false;
            _error = "Could not connect to the game server. Refresh the page to try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CreateGame()
    {
        if (!string.IsNullOrWhiteSpace(_playerName))
            await SendHubRequestAsync("CreateGame", _playerName.Trim());
    }

    private async Task JoinGame(string gameId)
    {
        if (!string.IsNullOrWhiteSpace(_playerName))
            await SendHubRequestAsync("JoinGame", gameId, _playerName.Trim(), (string?)null);
    }

    private Task SendHubRequestAsync(string method, params object?[] args)
    {
        if (_hub?.State != HubConnectionState.Connected)
        {
            _error = "The game server is not connected. Refresh the page to try again.";
            return InvokeAsync(StateHasChanged);
        }

        return SendHubRequestCoreAsync(method, args);
    }

    private async Task SendHubRequestCoreAsync(string method, object?[] args)
    {
        try
        {
            await _hub!.SendCoreAsync(method, args);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not send {HubMethod} from the home screen", method);
            _error = "That request could not reach the game server. Please try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void NavigateToGame(string gameId, string connectionId) =>
        _ = InvokeAsync(() => Nav.NavigateTo(
            $"/game/{gameId}?name={Uri.EscapeDataString(_playerName.Trim())}&connId={Uri.EscapeDataString(connectionId)}"));

    private void ShowServerError(string message) => _ = InvokeAsync(() =>
    {
        _error = message;
        StateHasChanged();
    });

    private void UpdateOpenGames(List<GameSummary> games) => _ = InvokeAsync(() =>
    {
        _openGames = games;
        StateHasChanged();
    });

    private async Task DisposeHubAsync()
    {
        if (_hub == null) return;
        try { await _hub.DisposeAsync(); }
        catch (Exception ex) { Logger.LogDebug(ex, "Error disposing the home screen connection"); }
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeHubAsync();
    }
}
