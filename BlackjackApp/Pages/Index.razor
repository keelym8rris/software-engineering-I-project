@page "/"
@page "/play"
@using BlackjackApp.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Logging
@inject NavigationManager Nav
@inject ILogger<Index> Logger
@implements IAsyncDisposable

<div class="lobby">
    <h1>♠ Blackjack</h1>

    @if (!_connected)
    {
        <p class="status">@(_error.Length == 0 ? "Connecting..." : "The game server is unavailable.")</p>
        @if (_error.Length > 0)
        {
            <p class="error" role="alert">@_error</p>
        }
    }
    else
    {
        <div class="lobby-panel">
            @if (_selectedMode == null)
            {
                <h2>How would you like to play?</h2>
                <div class="mode-options">
                    <button class="btn btn-primary" @onclick="() => SelectMode(GameMode.Solo)">Solo</button>
                    <p class="muted">Play against the house dealer on your own.</p>
                    <button class="btn btn-secondary" @onclick="() => SelectMode(GameMode.Multiplayer)">Multiplayer</button>
                    <p class="muted">Host a lobby for friends or join one with a code.</p>
                </div>
            }
            else
            {
                <h2>@_selectedMode</h2>
                <label for="player-name">Your name</label>
                <input id="player-name" @bind="_playerName" @bind:event="oninput" placeholder="Your name" maxlength="20" class="input" />

                @if (_selectedMode == GameMode.Solo)
                {
                    <p class="muted">Your own table, with the dealer controlled by the game.</p>
                    <button class="btn btn-primary" @onclick="CreateGame" disabled="@(_creating || string.IsNullOrWhiteSpace(_playerName))">
                        @(_creating ? "Creating..." : "Start Solo Game")
                    </button>
                }
                else
                {
                    <p class="muted">Create a lobby and share its code with your friends.</p>
                    <button class="btn btn-primary" @onclick="CreateGame" disabled="@(_creating || string.IsNullOrWhiteSpace(_playerName))">
                        @(_creating ? "Creating..." : "Host Lobby")
                    </button>
                    <form class="join-form" @onsubmit="JoinLobby" @onsubmit:preventDefault>
                        <label for="lobby-code">Have a lobby code?</label>
                        <input id="lobby-code" @bind="_lobbyCode" @bind:event="oninput" placeholder="8-character lobby code" maxlength="8" autocomplete="off" autocapitalize="characters" spellcheck="false" class="input code-input" />
                        <button type="submit" class="btn btn-secondary" disabled="@(_creating || string.IsNullOrWhiteSpace(_playerName) || string.IsNullOrWhiteSpace(_lobbyCode))">Join Lobby</button>
                    </form>
                }

                <button class="btn btn-secondary" @onclick="BackToModes" disabled="@_creating">Back</button>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="error" role="alert">@_error</p>
            }
        </div>
    }
</div>

@code {
    private HubConnection? _hub;
    private string _playerName = "";
    private string _error = "";
    private bool _connected = false;
    private GameMode? _selectedMode;
    private string _lobbyCode = "";
    private bool _creating;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/blackjackhub"))
                .WithAutomaticReconnect()
                .Build();

            _hub.On<string, string>("GameCreated", NavigateToGame);
            _hub.On<string>("Error", ShowServerError);

            _hub.Reconnecting += exception => InvokeAsync(() =>
            {
                _connected = false;
                _creating = false;
                _error = "Connection lost. Reconnecting...";
                StateHasChanged();
            });
            _hub.Reconnected += _ => InvokeAsync(() =>
            {
                _connected = true;
                _error = "";
                StateHasChanged();
            });
            _hub.Closed += exception => InvokeAsync(() =>
            {
                _connected = false;
                _creating = false;
                _error = "The connection closed. Refresh the page to try again.";
                StateHasChanged();
            });

            await _hub.StartAsync();
            _connected = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not connect to the blackjack server");
            _connected = false;
            _error = "Could not connect to the game server. Refresh the page to try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectMode(GameMode mode)
    {
        _selectedMode = mode;
        _error = "";
    }

    private void BackToModes()
    {
        _selectedMode = null;
        _error = "";
    }

    private async Task CreateGame()
    {
        if (_creating || _selectedMode == null || string.IsNullOrWhiteSpace(_playerName)) return;

        if (_hub?.State != HubConnectionState.Connected)
        {
            _error = "The game server is not connected. Refresh the page to try again.";
            return;
        }

        _creating = true;
        _error = "";
        try
        {
            await _hub.InvokeAsync("CreateGame", _playerName.Trim(), _selectedMode.Value.ToString());
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not create a game from the play menu");
            _error = "The game could not be created. Please try again.";
        }
        finally
        {
            _creating = false;
        }
    }

    private void JoinLobby()
    {
        if (_creating || string.IsNullOrWhiteSpace(_playerName)) return;

        var code = _lobbyCode.Trim().ToUpperInvariant();
        if (code.Length != 8 || !code.All(Uri.IsHexDigit))
        {
            _error = "Enter the 8-character code shown in your friend's lobby.";
            return;
        }

        Nav.NavigateTo($"/game/{code}?name={Uri.EscapeDataString(_playerName.Trim())}");
    }

    private void NavigateToGame(string gameId, string connectionId) =>
        _ = InvokeAsync(() => Nav.NavigateTo(
            $"/game/{gameId}?name={Uri.EscapeDataString(_playerName.Trim())}&connId={Uri.EscapeDataString(connectionId)}"));

    private void ShowServerError(string message) => _ = InvokeAsync(() =>
    {
        _error = message;
        _creating = false;
        StateHasChanged();
    });

    private async Task DisposeHubAsync()
    {
        if (_hub == null) return;
        try { await _hub.DisposeAsync(); }
        catch (Exception ex) { Logger.LogDebug(ex, "Error disposing the home screen connection"); }
    }

    public async ValueTask DisposeAsync()
    {
        await DisposeHubAsync();
    }
}
