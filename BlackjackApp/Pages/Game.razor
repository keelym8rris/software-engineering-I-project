@page "/game/{GameId}"
@using BlackjackApp.Models
@using BlackjackApp.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject ILogger<Game> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="game-layout @(CanUseChat ? "with-chat" : "") @(_chatCollapsed ? "chat-collapsed" : "")">
    <div class="game-workspace">
        <div class="game-table">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="error" role="alert">@_error</p>
    }
    @if (!string.IsNullOrWhiteSpace(_connectionStatus))
    {
        <p class="status" role="status">@_connectionStatus</p>
    }

    @if (_game == null)
    {
        @if (string.IsNullOrWhiteSpace(_error))
        {
            <p class="status">Connecting to game...</p>
        }
        else
        {
            <button class="btn btn-secondary" @onclick="LeaveGame">Back to game selection</button>
        }
    }
    else
    {
        <div class="game-header">
            <span class="game-id">@_game.Mode Blackjack</span>
            <span class="phase-badge">@_game.Phase</span>
            <span class="message">@_game.Message</span>
        </div>

        @if (_game.Phase == "Lobby" && _game.Mode == "Multiplayer")
        {
            <section class="room-info" aria-labelledby="lobby-code-heading">
                <h2 id="lobby-code-heading">Lobby code</h2>
                <code class="lobby-code">@_game.GameId</code>
                <p>Share this code with your friends. Choose Multiplayer and enter the code to join.</p>
                <p class="muted">@_game.Players.Count / 6 players</p>
            </section>
        }

        <!-- Dealer -->
        @if (_game.Phase != "Lobby")
        {
            <div class="dealer-area">
                <h3>Dealer @(_game.Phase == "Playing" ? "" : $"— {_game.Dealer.HandValue}")</h3>
                <div class="hand">
                    @for (int i = 0; i < _game.Dealer.Hand.Count; i++)
                    {
                        var card = _game.Dealer.Hand[i];
                        @if (card.IsHidden)
                        {
                            <div class="card card-back"></div>
                        }
                        else
                        {
                            <div class="card @(card.IsRed ? "red" : "black")">@card.Display</div>
                        }
                    }
                </div>
            </div>
        }

        <!-- Players -->
        <div class="players-area">
            @foreach (var player in _game.Players)
            {
                bool isMe = player.ConnectionId == _myConnectionId;
                bool isActive = _game.CurrentPlayerConnectionId == player.ConnectionId;
                <div class="player-seat @(isMe ? "me" : "") @(isActive ? "active" : "")">
                    <div class="player-name">
                        @player.Name
                        @if (isMe) { <span class="you-badge">You</span> }
                        @if (player.ConnectionId == _game.HostConnectionId) { <span class="host-badge">Host</span> }
                    </div>
                    <div class="player-chips">@player.Chips.ToString("N1") chips</div>
                    <div class="player-bet">Bet: @player.CurrentBet</div>
                    <div class="hand">
                        @foreach (var card in player.Hand)
                        {
                            <div class="card @(card.IsRed ? "red" : "black")">@card.Display</div>
                        }
                    </div>
                    @if (player.Hand.Count > 0)
                    {
                        <div class="hand-value">Value: @player.HandValue</div>
                    }
                    <div class="status-badge status-@player.Status.ToLower()">@player.Status</div>
                </div>
            }
        </div>

        <!-- Actions -->
        <div class="actions">
            @if (IsSpectator)
            {
                <section class="balance-notice" role="status" aria-labelledby="spectating-heading">
                    <h2 id="spectating-heading">You're spectating</h2>
                    <p>You can watch your friends play and chat, but cannot place bets or take turns.</p>
                    <button class="btn btn-secondary" @onclick="LeaveGame">Leave table</button>
                </section>
            }
            else if (Me == null || (Me.Chips < GameService.MinimumBet && (_game.Phase == "RoundOver" || _game.Phase == "Betting")))
            {
                <section class="balance-notice" role="status" aria-labelledby="balance-heading">
                    <h2 id="balance-heading">Out of chips?</h2>
                    <p>@(Me == null ? "Your seat has closed." : $"Your balance of {Me.Chips:N1} chips is below the {GameService.MinimumBet}-chip minimum bet.")</p>
                    @if (Me != null && _game.Mode == "Multiplayer" && _game.Phase == "RoundOver" &&
                         _game.Players.Any(p => p.ConnectionId != _myConnectionId && p.Chips >= GameService.MinimumBet))
                    {
                        <p>Stay at this table to watch and chat.</p>
                        <button class="btn btn-primary" @onclick="Spectate">Spectate table</button>
                    }
                    <button class="btn btn-secondary" @onclick="LeaveGame">Back to games</button>
                </section>
            }
            else if (_game.Phase == "Lobby")
            {
                @if (_game.HostConnectionId == _myConnectionId)
                {
                    <button class="btn btn-primary" @onclick="StartBetting" disabled="@(_game.Mode == "Multiplayer" && _game.Players.Count < 2 && _game.Spectators.Count == 0)">Start Game</button>
                    @if (_game.Mode == "Multiplayer" && _game.Players.Count < 2 && _game.Spectators.Count == 0)
                    {
                        <p class="muted">Waiting for a friend to join with your code. Multiplayer needs at least two players.</p>
                    }
                }
                else
                {
                    <p class="muted">Waiting for the host to start the game.</p>
                }
                <button class="btn btn-secondary" @onclick="LeaveGame">Leave Lobby</button>
            }
            else if (_game.Phase == "Betting")
            {
                var me = _game.Players.FirstOrDefault(p => p.ConnectionId == _myConnectionId);
                @if (me != null && me.CurrentBet == 0)
                {
                    <div class="bet-controls">
                        <label for="bet-amount">Bet amount (chips):</label>
                        <input id="bet-amount" type="number" @bind="_betAmount" @bind:event="oninput" min="@GameService.MinimumBet" max="@decimal.Floor(me.Chips)" step="1" class="input" />
                        <button class="btn btn-primary" @onclick="PlaceBet" disabled="@(_betAmount < GameService.MinimumBet || _betAmount > me.Chips)">Place Bet</button>
                    </div>
                    <div class="quick-bets">
                        @foreach (var amt in new[] { 10, 25, 50, 100 })
                        {
                            <button class="btn btn-chip" @onclick="() => QuickBet(amt)" disabled="@(amt > me.Chips)">@amt</button>
                        }
                    </div>
                }
                else
                {
                    <p class="muted">Waiting for other players to bet...</p>
                }
            }
            else if (_game.Phase == "Playing")
            {
                @if (_game.CurrentPlayerConnectionId == _myConnectionId)
                {
                    <button class="btn btn-primary" @onclick="Hit">Hit</button>
                    <button class="btn btn-secondary" @onclick="Stand">Stand</button>
                }
                else
                {
                    <p class="muted">Waiting for your turn...</p>
                }
            }
            else if (_game.Phase == "RoundOver")
            {
                <button class="btn btn-primary" @onclick="NewRound">New Round</button>
                <button class="btn btn-secondary" @onclick="LeaveGame">Leave</button>
            }
        </div>

        @if (_game.Mode == "Multiplayer" && _game.Spectators.Count > 0)
        {
            <p class="spectator-list">Spectating: @string.Join(", ", _game.Spectators.Select(s => s.Name))</p>
        }
    }
        </div>
    </div>
    @if (_game != null && CanUseChat)
    {
        <aside id="game-chat-sidebar" class="chat-sidebar @(_chatCollapsed ? "is-collapsed" : "")" aria-label="Chat">
            <div class="chat-sidebar-header">
                @if (!_chatCollapsed)
                {
                    <h2 id="chat-heading">Chat</h2>
                }
                <button type="button" class="chat-collapse-button" @onclick="ToggleChatCollapsed"
                        aria-label="@(_chatCollapsed ? "Expand chat" : "Collapse chat")"
                        aria-expanded="@(!_chatCollapsed)" title="@(_chatCollapsed ? "Expand chat" : "Collapse chat")">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                        <path d="M10 4v16"></path>
                        <path d="@(_chatCollapsed ? "M14 9l3 3-3 3" : "M18 9l-3 3 3 3")"></path>
                    </svg>
                </button>
            </div>
            @if (!_chatCollapsed)
            {
                <div id="chat-sidebar-content" class="chat-sidebar-content">
                    <div class="chat-messages" @ref="_chatMessagesElement" role="log"
                         aria-live="polite" aria-relevant="additions" aria-label="Messages">
                        @foreach (var message in _game.ChatMessages)
                        {
                            <p class="chat-message"><strong class="chat-sender chat-name-@(message.ColorIndex)">@message.Sender:</strong> @message.Text</p>
                        }
                    </div>
                    <form class="chat-form" @onsubmit="SendChat" @onsubmit:preventDefault>
                        @if (!string.IsNullOrWhiteSpace(_chatNotice) || _chatText.Length >= GameService.MaxChatLength)
                        {
                            <div class="chat-limit-card" role="status" aria-live="polite">
                                <span class="chat-limit-icon" aria-hidden="true">♥</span>
                                <div>
                                    <strong>@(string.IsNullOrWhiteSpace(_chatNotice) ? "Message limit reached!" : "Quick chat tip!")</strong>
                                    <p>@(_chatNotice ?? "That is 200 characters! Send your message or shorten it to keep typing.")</p>
                                </div>
                            </div>
                        }
                        <div class="chat-composer-row">
                            <input id="chat-input" class="input" @bind="_chatText" @bind:event="oninput"
                                   @bind:after="ClearChatNotice" maxlength="@GameService.MaxChatLength"
                                   aria-label="Chat message" autocomplete="off" placeholder="Message..." />
                            <button type="submit" class="btn btn-primary"
                                    disabled="@string.IsNullOrWhiteSpace(_chatText)">Send</button>
                        </div>
                    </form>
                </div>
            }
        </aside>
    }
</div>

@code {
    [Parameter] public string GameId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "name")] public string PlayerName { get; set; } = "Player";
    [SupplyParameterFromQuery(Name = "connId")] public string? PriorConnectionId { get; set; }

    private HubConnection? _hub;
    private GameStateDto? _game;
    private string _myConnectionId = "";
    private string _error = "";
    private string _connectionStatus = "";
    private bool _joining;
    private int _betAmount = 10;
    private string _chatText = "";
    private string? _chatNotice;
    private bool _chatCollapsed;
    private bool _pendingChatScroll;
    private string _lastChatSnapshot = "";
    private ElementReference _chatMessagesElement;
    private IJSObjectReference? _chatScrollModule;
    private PlayerDto? Me => _game?.Players.FirstOrDefault(p => p.ConnectionId == _myConnectionId);
    private bool IsSpectator => _game?.Spectators.Any(s => s.ConnectionId == _myConnectionId) == true;
    private bool CanUseChat => _game?.Mode == "Multiplayer" && (Me != null || IsSpectator);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (CanUseChat && !_chatCollapsed && _pendingChatScroll)
            {
                try
                {
                    _chatScrollModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat.js");
                    await _chatScrollModule.InvokeVoidAsync("scrollToLatest", _chatMessagesElement);
                    _pendingChatScroll = false;
                }
                catch (JSException ex)
                {
                    Logger.LogDebug(ex, "Could not scroll the chat panel");
                }
            }
            return;
        }

        GameId = GameId.Trim().ToUpperInvariant();

        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/blackjackhub"))
                .WithAutomaticReconnect()
                .Build();

            _hub.On<GameStateDto>("GameStateUpdated", UpdateGameState);
            _hub.On<string, string>("GameJoined", UpdateConnectionId);
            _hub.On<string>("Error", ShowServerError);

            _hub.Reconnecting += _ => InvokeAsync(() =>
            {
                _connectionStatus = "Connection lost. Reconnecting...";
                StateHasChanged();
            });
            _hub.Reconnected += async _ =>
            {
                await InvokeAsync(() =>
                {
                    _joining = true;
                    _connectionStatus = "Restoring your seat...";
                    StateHasChanged();
                });
                await SendHubRequestAsync("JoinGame", GameId, GetPlayerName(), _myConnectionId);
            };
            _hub.Closed += _ => InvokeAsync(() =>
            {
                _connectionStatus = "The connection closed. Return to the home page and rejoin the game.";
                StateHasChanged();
            });

            await _hub.StartAsync();
            _myConnectionId = _hub.ConnectionId ?? "";
            _joining = true;
            await SendHubRequestAsync("JoinGame", GameId, GetPlayerName(), PriorConnectionId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not connect to game {GameId}", GameId);
            _error = "Could not connect to this game. Return home and try joining again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetPlayerName() => string.IsNullOrWhiteSpace(PlayerName) ? "Player" : PlayerName.Trim();

    private async Task SendHubRequestAsync(string method, params object?[] args)
    {
        if (_hub?.State != HubConnectionState.Connected)
        {
            _error = "The game server is not connected. Please wait for it to reconnect.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            await _hub.SendCoreAsync(method, args);
            _error = "";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not send {HubMethod} for game {GameId}", method, GameId);
            _error = "That request could not reach the game server. Please try again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartBetting() => await SendHubRequestAsync("StartBetting", GameId);
    private async Task PlaceBet() => await SendHubRequestAsync("PlaceBet", GameId, _betAmount);
    private void QuickBet(int amount) => _betAmount = amount;
    private async Task Hit() => await SendHubRequestAsync("Hit", GameId);
    private async Task Stand() => await SendHubRequestAsync("Stand", GameId);
    private async Task NewRound() => await SendHubRequestAsync("NewRound", GameId);
    private void LeaveGame() => Nav.NavigateTo("/");
    private async Task Spectate() => await SendHubRequestAsync("Spectate", GameId);
    private void ToggleChatCollapsed()
    {
        _chatCollapsed = !_chatCollapsed;
        if (!_chatCollapsed)
            _pendingChatScroll = true;
    }

    private void ClearChatNotice() => _chatNotice = null;

    private async Task SendChat()
    {
        var message = _chatText.Trim();
        if (message.Length == 0) return;
        if (message.Length > GameService.MaxChatLength || message.Any(char.IsControl))
        {
            _chatNotice = "Please keep messages under 200 characters and avoid control characters.";
            return;
        }

        _chatNotice = null;
        await SendHubRequestAsync("SendChat", GameId, message);
        _chatText = "";
    }

    private void UpdateGameState(GameStateDto state) => _ = InvokeAsync(() =>
    {
        // Don't jump when a card is played; scroll only when chat changes.
        var chatSnapshot = string.Join("\u001f", state.ChatMessages.Select(m =>
            $"{m.Sender}\u001e{m.ColorIndex}\u001e{m.Text}"));
        if (!string.Equals(chatSnapshot, _lastChatSnapshot, StringComparison.Ordinal))
        {
            _lastChatSnapshot = chatSnapshot;
            _pendingChatScroll = true;
        }

        _game = state;
        StateHasChanged();
    });

    private void UpdateConnectionId(string ignoredGameId, string connectionId) => _ = InvokeAsync(() =>
    {
        _myConnectionId = connectionId;
        _joining = false;
        _connectionStatus = "";
        _error = "";
        StateHasChanged();
    });

    private void ShowServerError(string message) => _ = InvokeAsync(() =>
    {
        if (_joining)
        {
            _joining = false;
            _game = null;
            _connectionStatus = "";
        }

        if (message.StartsWith("Enter a message between 1 and 200 characters", StringComparison.OrdinalIgnoreCase))
        {
            // Keep chat validation next to the composer instead of at the top of the table.
            _chatNotice = "Your message needs to be 1–200 characters, without control characters.";
            StateHasChanged();
            return;
        }

        _error = message;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_chatScrollModule != null)
        {
            try { await _chatScrollModule.DisposeAsync(); }
            catch (JSException ex) { Logger.LogDebug(ex, "Could not dispose chat scroll module"); }
        }

        if (_hub == null) return;
        try { await _hub.DisposeAsync(); }
        catch (Exception ex) { Logger.LogDebug(ex, "Error disposing the connection for game {GameId}", GameId); }
    }
}
