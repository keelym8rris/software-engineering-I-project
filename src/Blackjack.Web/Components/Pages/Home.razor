@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject LobbyPrototypeService Lobby

<PageTitle>Blackjack · Home</PageTitle>

<section class="hero-grid">
    <div class="hero-copy">
        <span class="eyebrow">PRIVATE CARD ROOM</span>
        <h1>Quiet luxury for multiplayer Blackjack.</h1>
        <p class="lede">Host a table, share a code, and keep the flow focused on the cards. This is a polished foundation for a student-built Blackjack room.</p>

        <div class="hero-actions">
            <button class="button primary large" @onclick='() => Nav.NavigateTo("/host")'>Host a Table</button>
            <button class="button secondary large" @onclick='() => Nav.NavigateTo("/join")'>Join a Table</button>
        </div>

        <div class="name-card panel">
            <div class="panel-heading"><span>Display name</span><span class="muted">saved locally</span></div>
            <label for="displayName">How should the table know you?</label>
            <div class="inline-control">
                <input id="displayName" @bind="displayName" maxlength="24" placeholder="Enter a display name" />
                <button class="button subtle" @onclick="SaveName">Save</button>
            </div>
            <p class="helper-text">This stays in local session state so navigation feels seamless.</p>
        </div>
    </div>

    <aside class="table-preview panel">
        <div class="table-felt table-felt-home" aria-hidden="true">
            <span class="table-label">BLACKJACK PAYS 3 TO 2</span>
            <div class="card-fan">
                <div class="playing-card red-card">A<span>♥</span></div>
                <div class="playing-card dark-card">K<span>♠</span></div>
            </div>
            <div class="dealer-chip">DEALER</div>
            <div class="chip-stack">
                <span></span><span></span><span></span>
            </div>
        </div>
    </aside>
</section>

<section class="dashboard-grid">
    <article class="panel stat-panel">
        <div class="panel-heading"><span>Player profile</span><span class="muted">prototype</span></div>
        <h2>@Lobby.DisplayName</h2>
        <div class="stat-stack">
            <div class="stat-row"><span>Games played</span><strong>0</strong></div>
            <div class="stat-row"><span>Wins</span><strong>0</strong></div>
            <div class="stat-row"><span>Losses</span><strong>0</strong></div>
            <div class="stat-row"><span>Win rate</span><strong>—</strong></div>
            <div class="stat-row"><span>Best streak</span><strong>—</strong></div>
        </div>
        <button class="text-button" disabled>Member login placeholder · future authentication</button>
    </article>

    <article class="panel">
        <div class="panel-heading"><span>Table state</span><span class="live-badge">1 live</span></div>
        <div class="game-list-item">
            <div class="game-icon">21</div>
            <div><strong>Blackjack</strong><p>2–8 players · private code · house rules</p></div>
            <span class="tag">Ready</span>
        </div>
        <div class="game-list-item">
            <div class="game-icon ghost">$</div>
            <div><strong>Bankroll tracking</strong><p>Prototype stats are intentionally local and easy to replace later.</p></div>
            <span class="tag">Local</span>
        </div>
        <div class="game-list-item disabled-row">
            <div class="game-icon ghost">?</div>
            <div><strong>More table games</strong><p>Future game engines can share the same lobby and table shell.</p></div>
            <span class="tag">Later</span>
        </div>
    </article>

    <article class="panel credits-panel">
        <div class="panel-heading"><span>Project</span><span class="muted">SE I</span></div>
        <h3>Built for the semester.</h3>
        <p>Multiplayer transport, persistence, authentication, and deployment are intentionally left as clear engineering boundaries for your team.</p>
        <div class="tech-stack"><span>C#</span><span>Blazor</span><span>.NET 10</span><span>Server-side</span></div>
    </article>
</section>

@code {
    private string displayName = "Guest";
    protected override void OnInitialized() => displayName = Lobby.DisplayName;
    private void SaveName()
    {
        Lobby.DisplayName = string.IsNullOrWhiteSpace(displayName) ? "Guest" : displayName.Trim();
        displayName = Lobby.DisplayName;
    }
}
