@page "/join"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject LobbyPrototypeService Lobby

<PageTitle>Join a Lobby</PageTitle>

<section class="center-stage">
    <div class="panel form-panel narrow join-shell">
        <SectionHeader Kicker="JOIN A TABLE" Title="Enter your lobby code." Description="Ask the host for the six-character code shown in the lobby." Compact="true" />

        <label for="joinName">Display name</label>
        <input id="joinName" @bind="displayName" maxlength="24" placeholder="Your name" />

        <label for="joinCode">Lobby code</label>
        <input id="joinCode" class="code-input" @bind="joinCode" maxlength="6" placeholder="ABC123" inputmode="text" autocomplete="off" spellcheck="false" />

        <div class="code-hint-row">
            <span>Six characters</span>
            <span>Auto-uppercase</span>
            <span>Paste friendly</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="notice">@message</div>
        }

        <div class="stack-actions">
            <button class="button primary large" @onclick="JoinLobby">Join Table</button>
            <a class="button ghost" href="/">Back Home</a>
        </div>

        <p class="helper-text">Prototype note: this page will later connect to shared lobby state and validation services.</p>
    </div>
</section>

@code {
    private string displayName = "";
    private string joinCode = "";
    private string message = "";

    protected override void OnInitialized() => displayName = Lobby.DisplayName;

    private void JoinLobby()
    {
        if (string.IsNullOrWhiteSpace(joinCode))
        {
            message = "Enter a lobby code first.";
            return;
        }

        Lobby.DisplayName = string.IsNullOrWhiteSpace(displayName) ? "Guest" : displayName.Trim();
        Lobby.AddPrototypePlayer(Lobby.DisplayName);
        Nav.NavigateTo("/lobby");
    }
}
